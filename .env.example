# =================================
# Variables d'environnement - Template
# Copier ce fichier en .env et remplir les valeurs
# =================================

# Base de données
# Valeurs du conteneur local défini dans compose.yaml (docker compose up -d --wait)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=soskate
DB_USERNAME=soskate
DB_PASSWORD=soskate

# Application
SERVER_PORT=8080
CONTEXT_PATH=/api

# Environnement
SPRING_PROFILES_ACTIVE=dev

# JWT
# Clé HMAC encodée en Base64, 32 octets minimum. Générer avec : openssl rand -base64 32
JWT_SECRET=votreCleBase64
# Durée de validité d'un jeton, en millisecondes (86400000 = 24 h)
JWT_EXPIRATION=86400000

# AWS S3 (stockage des photos)
AWS_ACCESS_KEY_ID=votreAccessKeyId
AWS_SECRET_ACCESS_KEY=votreSecretAccessKey